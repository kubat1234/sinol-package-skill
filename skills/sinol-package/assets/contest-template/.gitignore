# sinol-make
.cache/
/*/in/.md5sums
/*/out/.md5sums
/*/*.tgz
/*/*.zip
/_export/
/_build/

# Tests: all of them (statement examples and ocen tests too) are generated by
# prog/<id>ingen.cpp with `sinol-make gen` - none is committed. A package
# WITHOUT a generator commits its tests: put `!*.in` in <id>/in/.gitignore and
# `!*.out` in <id>/out/.gitignore.
/*/in/*.in
/*/out/*.out

# Statements are built by `sinol-make doc`
/*/doc/*.pdf
*.aux
*.log
/*/doc/*.out
*.dvi
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# Binaries compiled by hand inside prog/
/*/prog/*
!/*/prog/*.c
!/*/prog/*.cpp
!/*/prog/*.h
!/*/prog/*.hpp
!/*/prog/*.py
!/*/prog/*.java
!/*/prog/*.rs
!/*/prog/*.sh

__pycache__/
